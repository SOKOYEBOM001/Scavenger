{
  "name": "scavenger-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Scavenger platform",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --include '**/*.contract.test.ts'",
    "test:backend": "vitest run --include '**/*.backend.test.ts'",
    "test:frontend": "vitest run --include '**/*.frontend.test.ts'",
    "test:e2e": "vitest run --include '**/*.e2e.test.ts'",
    "test:all": "vitest run",
    "lint": "eslint . --ext ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "vitest": "^1.1.0"
  },
  "dependencies": {
    "axios": "^1.6.5"
  }
}
